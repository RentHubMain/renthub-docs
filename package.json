{
  "name": "renthub-docs",
  "version": "0.0.1",
  "private": true,
  "description": "RentHub文档站（租汇官方文档与知识库，Docusaurus）：轻资产物品与工业设备租赁（C2C 优先）等主题。",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "format:md": "node scripts/format-markdown.mjs",
    "format:md:check": "node scripts/format-markdown.mjs --check",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/preset-classic": "^3.7.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "lucide-react": "^1.8.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.7.0",
    "@docusaurus/tsconfig": "^3.7.0",
    "@docusaurus/types": "^3.7.0",
    "typescript": "~5.2.2",
    "vite-plus": "0.2.2"
  },
  "overrides": {
    "@docsearch/css": "^3",
    "@docsearch/js": "^3",
    "@docsearch/react": "^3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2",
    "webpack": "5.95.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 3 safari version"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=18.0"
  }
}
